@model List<POS.Models.Entities.Product>
@{
    ViewData["Title"] = "Menu";
}

<div class="d-flex justify-content-between align-items-end mt-4 mb-3">
    <div>
        <h1>Our Menu</h1>
        <p class="text-muted mb-0">Freshly brewed, freshly baked. Pick your order for the cashier.</p>
    </div>
    <a asp-controller="Cart" asp-action="Index" class="btn btn-munchi">View Cart</a>
</div>

<div class="row g-4">
    @foreach (var product in Model)
    {
        var outOfStock = product.IsOutOfStock;
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="product-card @(outOfStock ? "out-of-stock" : "")">
                <img src="~/images/products/@product.ImageFileName" alt="@product.Name" />
                <div class="card-body">
                    <h3 class="card-title h5">@product.Name</h3>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="product-price">@product.Price.ToString("C")</span>
                        @if (outOfStock)
                        {
                            <span class="badge bg-secondary stock-badge">Out of Stock</span>
                        }
                        else
                        {
                            <span class="badge bg-success-subtle text-success-emphasis stock-badge">@product.StockQuantity in stock</span>
                        }
                    </div>

                    @if (!outOfStock)
                    {
                        <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-flex gap-2">
                            <input type="hidden" name="ProductId" value="@product.Id" />
                            <input type="number" name="Quantity" value="1" min="1" max="@product.StockQuantity" class="form-control qty-input" />
                            <button type="submit" class="btn btn-munchi flex-grow-1">Add</button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-secondary w-100" disabled>Unavailable</button>
                    }
                </div>
            </div>
        </div>
    }
</div>
